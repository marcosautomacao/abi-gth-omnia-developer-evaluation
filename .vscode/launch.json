{
    "version": "0.2.0",
    "configurations": [
        {
            // "logging": {
            //     "diagnosticsLog": {
            //         "protocolMessages": true
            //     },
            //     "trace": true
            // },
            "name": "Docker .NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "pipeTransport": {
                "pipeCwd": "${workspaceRoot}",
                "pipeProgram": "docker",
                "pipeArgs": ["exec", "-i", "ambev_developer_evaluation_webapi", "sh", "-c"],
                "debuggerPath": "/vsdbg/vsdbg"
            },
            "sourceFileMap": {
                "/src": "${workspaceRoot}\\template\\backend"
            }
        }
    ]
}